# ── LLM Provider Configuration ────────────────────────────
# Select which LLM provider to use.
# Options: groq | ollama | openai
# If unset, the application auto-detects (Groq → OpenAI → Ollama)
LLM_PROVIDER=groq

# ── Groq (Recommended — Free Tier) ───────────────────────
# Get a free API key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# ── Ollama (Local — Zero Cost) ────────────────────────────
# Install: https://ollama.ai  then run: ollama pull llama3.2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── OpenAI (Optional) ─────────────────────────────────────
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-3.5-turbo
# OPENAI_BASE_URL=  # optional: for Azure or compatible endpoints

# ── Application ───────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
RELOAD=false

# ── Dataset ───────────────────────────────────────────────
# Override CSV path (default: data/support_tickets.csv)
# CSV_PATH=data/support_tickets.csv
